{
  "displayName": "Somfy Protect",
  "name": "homebridge-somfy-protect-alarm",
  "version": "2.0.1",
  "description": "Allows somfy protect alarm to be exposed to homekit via myfox api.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothe-ignace/homebridge-somfy-protect.git"
  },
  "bugs": {
    "url": "https://github.com/timothe-ignace/homebridge-somfy-protect/issues"
  },
  "homepage": "https://github.com/timothe-ignace/homebridge-somfy-protect#readme",
  "engines": {
    "node": "^22.12.0 || ^24 || ^26",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "config.schema.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint src test scripts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "test": "rimraf ./.test-dist && tsc -p tsconfig.test.json && node -e \"require('fs').copyFileSync('package.json', '.test-dist/package.json')\" && node --test \".test-dist/test/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "husky || true"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "somfy",
    "somfy protect",
    "somfy-protect",
    "homekit",
    "alarm",
    "security"
  ],
  "dependencies": {
    "axios": "^1.21.1"
  },
  "peerDependencies": {
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "homebridge": "^2.5.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.9"
    }
  }
}
